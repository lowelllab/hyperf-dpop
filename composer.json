{
  "name": "lowelllab/hyperf-dpop-workspace",
  "description": "Development and verification workspace for a Hyperf DPoP extension.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2.35 <8.6",
    "lowelllab/dpop-core": "^0.2@dev",
    "lowelllab/hyperf-dpop": "^0.3@dev",
    "hyperf/framework": "~3.2.0",
    "hyperf/di": "~3.2.0",
    "hyperf/command": "~3.2.0"
  },
  "require-dev": {
    "hyperf/devtool": "~3.2.0",
    "hyperf/redis": "~3.2.0",
    "phpstan/phpstan": "^2.3"
  },
  "repositories": [{"type": "path", "url": "packages/*", "options": {"symlink": true, "versions": {"lowelllab/dpop-core": "0.2.x-dev", "lowelllab/hyperf-dpop": "0.3.x-dev"}}}],
  "autoload-dev": {"psr-4": {"DpopTest\\": "tests/", "DpopExample\\": "examples/hyperf/app/"}},
  "config": {"platform": {"php": "8.2.35"}, "sort-packages": true, "allow-plugins": {}},
  "scripts": {
    "test": "phpunit --display-deprecations --fail-on-deprecation --fail-on-skipped tests",
    "analyse": "phpstan analyse --memory-limit=512M --no-progress",
    "check": ["@test", "@analyse", "@php tools/lint.php", "@php tests/concurrency.php", "@php tests/coroutine.php", "@php tests/package-cli.php"],
    "validate-packages": ["@composer validate --strict", "@composer validate --strict packages/dpop-core/composer.json", "@composer validate --strict packages/hyperf-dpop/composer.json"]
  }
}
