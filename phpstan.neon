parameters:
    level: 6
    phpVersion:
        min: 80235
        max: 80599
    paths:
        - packages/dpop-core/src
        - packages/hyperf-dpop/src
    tmpDir: build/phpstan
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - identifier: missingType.iterableValue
